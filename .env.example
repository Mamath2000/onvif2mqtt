# Identifiants référencés par ${VAR} dans config.conf
# Copier vers .env (gitignoré) et renseigner les valeurs.
# Pas de guillemets autour des valeurs avec env_file Docker Compose (sauf si voulu).
# Une variable doit être définie, mais peut être vide (ex. MQTT sans authentification).
MQTT_USERNAME=
MQTT_PASSWORD=
CAMERA_SALON_USERNAME=
CAMERA_SALON_PASSWORD=
CAMERA_JARDIN_USERNAME=
CAMERA_JARDIN_PASSWORD=
