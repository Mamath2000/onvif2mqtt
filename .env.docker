# Configuration MQTT
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=onvif-gateway

# Intégration Home Assistant
HA_DISCOVERY_ENABLED=true
HA_BASE_TOPIC=onvif2mqtt
HA_DEVICE_NAME=ONVIF Gateway
HA_DEVICE_ID=onvif_gateway

# Configuration des caméras ONVIF
# Format JSON avec les détails de vos caméras
ONVIF_CAMERAS=[]

# Fuseau horaire
TZ=Europe/Paris

# Configuration supplémentaire
NODE_ENV=production